# Артефакты Swift Package создаются локально и воспроизводятся командой сборки.
.build/
dist/
.swiftpm/

# Локальные настройки IDE и диагностические артефакты не воспроизводимы.
*.xcuserstate
xcuserdata/
*.dSYM
.idea/

# Секреты и локальные параметры никогда не должны попасть в историю.
.env
.env.*
!.env.example

# Служебный файл Finder не относится к исходному коду проекта.
.DS_Store
__pycache__/
*.py[cod]
